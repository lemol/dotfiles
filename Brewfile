# Everything the Tokyo Night terminal setup needs.
# Install with:  brew bundle --file=Brewfile

# ── the terminal itself ───────────────────────────────────────
cask "cmux"                      # Ghostty-based terminal + AI agent workspaces

# ── prompt & shell tooling ────────────────────────────────────
brew "starship"                  # the powerline prompt (vim-airline equivalent)
brew "eza"                       # ls with icons + git status
brew "bat"                       # cat/man with syntax highlighting
brew "zoxide"                    # `z <dir>` frecency jumping
brew "git-delta"                 # git diff pager
brew "fzf"                       # fuzzy finder
brew "fd"                        # fast find, backs FZF_DEFAULT_COMMAND
brew "ripgrep"                   # fast grep

# ── editor ────────────────────────────────────────────────────
brew "neovim"

# ── fonts ─────────────────────────────────────────────────────
cask "font-fira-code-nerd-font"  # supplies the powerline + devicon glyphs
